flowchart TB
    U["<b>USERS</b><br/>creator, freelancer, or both<br/>profile + Prava account ref"]

    subgraph FREELANCER["FREELANCER SIDE"]
      direction LR
      SA["<b>SOCIAL_ACCOUNTS</b><br/>public account URL only<br/>followers, following, karma"]
      FEED["<b>ELIGIBLE FEED</b><br/><i>get_eligible_bounties()</i><br/>validated public profile + range"]
      BC["<b>BOUNTY_CLAIMS</b><br/>one claimed slot<br/>claimed → approved → paid"]
      S["<b>SUBMISSIONS</b><br/>revisions + verification"]
      SP["<b>SUBMISSION_PROOFS</b><br/>URL / screenshot / image"]
      SA --> FEED --> BC --> S --> SP
    end

    subgraph CREATOR["CREATOR SIDE"]
      direction LR
      T["<b>TASKS</b><br/>campaign + total budget<br/>manual or MCP"]
      B["<b>BOUNTIES</b><br/>Reddit / LinkedIn<br/>post / comment<br/>reward + slots + range + proof rules"]
      T -->|"has subtasks"| B
    end

    subgraph PAYMENT["AUTOMATIC PRAVA PAYOUT"]
      direction LR
      PA["<b>PAYMENT_AUTHORIZATIONS</b><br/>task-level approval + caps"]
      P["<b>PAYMENTS</b><br/>one idempotent payout<br/>creator → freelancer"]
      PTA["<b>PAYMENT_ATTEMPTS</b><br/>provider retries + results"]
      PA --> P --> PTA
    end

    subgraph AGENT["AGENT + WEBHOOK INTEGRATION"]
      direction LR
      AC["<b>API_CLIENTS</b><br/>hashed credentials + scopes"]
      MR["<b>MCP_REQUESTS</b><br/>idempotent call log"]
      WE["<b>WEBHOOK_ENDPOINTS</b><br/>creator URL + secret hash"]
      WD["<b>WEBHOOK_DELIVERIES</b><br/>retryable result event"]
      AC --> MR
      WE --> WD
    end

    U -->|"submits public profile"| SA
    U -->|"creates"| T
    B -->|"appears when eligible"| FEED
    B -->|"fills a slot"| BC
    T -->|"payment permission"| PA
    S -->|"passed verification"| P
    BC -->|"exact reward + payee"| P
    U -->|"owns creator client"| AC
    MR -->|"creates task / verifies"| T
    U -->|"owns callback"| WE
    S -.->|"verification event"| WD
    P -.->|"payment event"| WD

    classDef identity fill:#111827,color:#ffffff,stroke:#111827,stroke-width:2px;
    classDef freelancer fill:#ecfeff,color:#164e63,stroke:#0891b2,stroke-width:2px;
    classDef creator fill:#eef2ff,color:#312e81,stroke:#6366f1,stroke-width:2px;
    classDef payment fill:#ecfdf5,color:#14532d,stroke:#10b981,stroke-width:2px;
    classDef agent fill:#fff7ed,color:#7c2d12,stroke:#f97316,stroke-width:2px;
    class U identity;
    class SA,FEED,BC,S,SP freelancer;
    class T,B creator;
    class PA,P,PTA payment;
    class AC,MR,WE,WD agent;
