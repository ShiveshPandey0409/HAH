DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hire_human
APP_ENV=development
LOG_LEVEL=INFO
MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp
MCP_OAUTH_ISSUER_URL=http://localhost:9000
# Configure all three introspection values together. Without them, /mcp remains protected
# and rejects every bearer token. Staging and production require HTTPS values and a secret.
# Introspection must also return the documented non-secret, never-reused authorization_id.
# MCP_OAUTH_INTROSPECTION_URL=http://localhost:9000/introspect
# MCP_OAUTH_INTROSPECTION_CLIENT_ID=hire-a-human-resource-server
# MCP_OAUTH_INTROSPECTION_CLIENT_SECRET=replace-me
MCP_OAUTH_INTROSPECTION_TIMEOUT_SECONDS=5
MCP_OAUTH_CLOCK_SKEW_SECONDS=30
MCP_OAUTH_MAX_TOKEN_LIFETIME_SECONDS=3600
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]
# Development-only Fernet key for webhook secrets and destination URLs. Rotate for deployment.
WEBHOOK_SECRET_ENCRYPTION_KEYS=["MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA="]
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_DNS_TIMEOUT_SECONDS=3
WEBHOOK_LEASE_SECONDS=30
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_RETRY_CAP_SECONDS=3600
WEBHOOK_POLL_INTERVAL_SECONDS=1
WEBHOOK_WORKER_ENABLED=false
HTTP_SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# SMTP is required for forgot-password delivery. Keep all values private in deployment.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_FROM_EMAIL=no-reply@example.com

# Prava sandbox task funding. The secret key and payer email are the only private
# server values. Never put a card number, CVV, expiry, passkey, or OTP in this file.
PRAVA_PAYMENT_AUTOMATION_ENABLED=false
PRAVA_PAYMENT_WORKER_ENABLED=false
PRAVA_BASE_URL=https://sandbox.api.prava.space
# PRAVA_SECRET_KEY=sk_test_replace_me
PRAVA_PAYER_USER_ID=hah-universal-hackathon-payer
# PRAVA_PAYER_EMAIL=hackathon-payer@example.com
PRAVA_MERCHANT_NAME=Hire a Human
PRAVA_MERCHANT_URL=https://hah-api-prava.onrender.com
PRAVA_MERCHANT_COUNTRY=IN
PRAVA_SETTLEMENT_MODE=prava_sandbox
PRAVA_REQUEST_TIMEOUT_SECONDS=10
PRAVA_PAYMENT_MAX_ATTEMPTS=4
PRAVA_PAYMENT_LEASE_SECONDS=45
PRAVA_PAYMENT_RETRY_BASE_SECONDS=15
PRAVA_PAYMENT_RETRY_CAP_SECONDS=300
PRAVA_PAYMENT_POLL_INTERVAL_SECONDS=1
