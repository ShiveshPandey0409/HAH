{
  "name": "hah-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"cd ../backend && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port ${API_PORT:-8000}\" \"vite --host 127.0.0.1 --port ${WEB_PORT:-5173}\"",
    "dev:frontend": "vite",
    "dev:backend": "cd ../backend && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port ${API_PORT:-8000}",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.9.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
